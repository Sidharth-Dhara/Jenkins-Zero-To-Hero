pipeline {
  agent {
    docker {
      image 'kaur1997/maven-jdk17-docker:v6'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
      reuseNode true
    }
  }

  stages {

    stage('Verify Java') {
      steps {
        sh '''
          export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
          export PATH=$JAVA_HOME/bin:$PATH

          echo "Using JAVA_HOME: $JAVA_HOME"
          java -version
          javac -version
         '''
      }
    }

    stage('Checkout') {
      steps {
        sh 'echo passed'
        checkout scm
        sh "curl -v http://35.172.140.64:9000"
      }
    }

    stage('Build and Test') {
      steps {
        sh '''
          export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
          export PATH=$JAVA_HOME/bin:$PATH

          echo "Maven Version:"
          mvn -version

          cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
          mvn clean package
        '''
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://35.172.140.64:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
            export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
            export PATH=$JAVA_HOME/bin:$PATH

            echo "Using Java for Sonar:"
            java -version
            mvn -version

            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
            mvn -U clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}
          '''
        }
      }
    }

    stage('Build and Push Docker Image') {
    environment {
        DOCKER_IMAGE = "kaur1997/ultimate-cicd:${BUILD_NUMBER}"
        DOCKER_CLI_VERSION = "27.5.1"
    }

    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'docker-cred',
                usernameVariable: 'DOCKER_USERNAME',
                passwordVariable: 'DOCKER_PASSWORD'
            )
        ]) {
            sh '''
                set -e

                mkdir -p .docker-cli

                # Download a newer Docker CLI
                if [ ! -x .docker-cli/docker ]; then
                    wget -q \
                      "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
                      -O /tmp/docker-cli.tgz

                    tar -xzf /tmp/docker-cli.tgz \
                      --strip-components=1 \
                      -C .docker-cli \
                      docker/docker

                    chmod +x .docker-cli/docker
                fi

                DOCKER_BIN="$WORKSPACE/.docker-cli/docker"

                # Remove the old forced API version
                unset DOCKER_API_VERSION

                echo "Checking updated Docker CLI:"
                "$DOCKER_BIN" version

                echo "$DOCKER_PASSWORD" | "$DOCKER_BIN" login \
                  --username "$DOCKER_USERNAME" \
                  --password-stdin

                "$DOCKER_BIN" build \
                  -t "$DOCKER_IMAGE" \
                  java-maven-sonar-argocd-helm-k8s/spring-boot-app

                "$DOCKER_BIN" push "$DOCKER_IMAGE"

                "$DOCKER_BIN" logout
            '''
        }
    }
}

    stage('Update Deployment File') {
      environment {
        GIT_REPO = "https://github.com/Sidharth-Dhara/Jenkins-Zero-To-Hero.git"
        GIT_CREDENTIALS = "github"
        GIT_USER_NAME = "Sidharth-Dhara"
        GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
      }
      steps {
        checkout scm
        withCredentials([string(credentialsId: env.GIT_CREDENTIALS, variable: 'GITHUB_TOKEN')]) {
          sh """
            git config user.email "sidcourseall@gmail.com"
            git config user.name "${GIT_USER_NAME}"
            sed -i "s|image: .*|image: kaur1997/ultimate-cicd:${BUILD_NUMBER}|g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            git commit -m "Update deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
          """
        }
      }
    }

  }
}
